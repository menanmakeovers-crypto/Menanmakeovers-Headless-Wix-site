---
// Fine line drawings for the package cards: a four-point sparkle, and arch-framed sketches of a
// bride's face (makeup + hairstyling) and a draped saree. Stroke colour follows `color`.
interface Props {
  name: "sparkle" | "face" | "drape";
  class?: string;
}
const { name, class: className } = Astro.props;
---
{name === "sparkle" && (
  <svg class={className} viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
    <path d="M12 0C12.9 7.6 16.4 11.1 24 12 16.4 12.9 12.9 16.4 12 24 11.1 16.4 7.6 12.9 0 12 7.6 11.1 11.1 7.6 12 0Z" />
  </svg>
)}
{name === "face" && (
  <svg class={className} viewBox="0 0 64 96" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
    <path d="M4 94V32a28 28 0 0 1 56 0v62Z" />
    <path d="M20 47c-2-15 9-22 16-21 9 1 12 10 10 22" />
    <path d="M46 48c2 12 4 22 9 30" />
    <path d="M22 47c0 15 6 25 12 25s10-8 11-20" />
    <path d="M27 48.5c2-1 4-1 6 0" />
    <path d="M27 52.5c2 2 4 2 6 0M28 53.8l-1 1.8M30 54.4v2M32 53.8l1 1.8" />
    <path d="M35.5 52.5c0 3.5 0 5.5-2 7.5l2 .5" />
    <path d="M31 64.5c2 1.3 4 1.3 6 0-2 2.6-4 2.6-6 0Z" />
    <path d="M30 72v10M38.5 71l.5 11" />
    <path d="M30 82c-7 2-13 5-17 11M39 82c6 2 11 5 14 11" />
  </svg>
)}
{name === "drape" && (
  <svg class={className} viewBox="0 0 64 96" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
    <path d="M4 94V32a28 28 0 0 1 56 0v62Z" />
    <path d="M13 40c13 6 21 19 27 54" />
    <path d="M21 33c13 10 21 25 27 61" />
    <path d="M31 28c11 13 19 32 24 64" />
    <path d="M9 52c14 4 21 12 25 24" />
    <path d="M14 72v22M19.5 70v24M25 72v22" />
  </svg>
)}
